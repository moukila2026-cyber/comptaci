# --- Supabase (obligatoire) -------------------------------------------------
VITE_SUPABASE_URL=colle_ici_ton_project_url
VITE_SUPABASE_ANON_KEY=colle_ici_ta_cle_anon_public

# --- SasPay : paiement par lien (remplace l'ancien QR code Wave) -------------
# Les 3 liens ComptaCi sont déjà codés en dur dans `saspay.js` (aucune
# configuration requise). Ces variables permettent de les changer sans
# redéployer de code (utile en test).
VITE_SASPAY_URL_STARTER=https://link.saspay.me/vmtjcwrgafk
VITE_SASPAY_URL_PRO=https://link.saspay.me/vrgqoaut3ba
VITE_SASPAY_URL_ENTREPRISE=https://link.saspay.me/zszja0kudmy
# Lien générique de secours (toutes formules) — facultatif.
VITE_SASPAY_PAYMENT_URL=
VITE_SASPAY_MARCHAND=ComptaCi
# "test" pour tester sans encaisser, "live" en production
VITE_SASPAY_MODE=live

# --- Webhook SasPay (activation automatique des abonnements) ----------------
# Côté SUPABASE (jamais dans ce fichier, qui est exposé au navigateur) :
#   supabase secrets set SASPAY_WEBHOOK_SECRET=xxxxx   ← déjà configuré
#   supabase functions deploy webhook-saspay --no-verify-jwt
# Puis, dans le tableau de bord SasPay, renseigne l'URL :
#   https://<project-ref>.supabase.co/functions/v1/webhook-saspay
# Le webhook lit le secret tout seul (Deno.env.get) : rien à coller ici.

# --- KOMPTO — Facture Normalisée Électronique (FNE / DGI Côte d'Ivoire) -----
# Intégration via l'API publique KOMPTO (guide v5.2). En sandbox, les factures
# sont émises au nom de PROGICI SARL / SIEGE, sans valeur fiscale.
#
# Variables navigateur (VITE_*) : permettent de surcharger l'hôte sans toucher
# au code. La clé API reste stockée par établissement en base (voir ci-dessous),
# pas dans le .env — ce fichier ne sert que pour le mode dev / tests.
VITE_KOMPTO_API_URL=https://qa.kompto.com
VITE_KOMPTO_VERIF_URL=https://fne.dgi.gouv.ci/verification
# Clé sandbox optionnelle pour les tests locaux (UUID KOMPTO, vide par défaut)
# VITE_KOMPTO_API_KEY=colle_ici_ta_cle_sandbox_kompto
# En production : basculer VITE_KOMPTO_API_URL vers l'hôte prod fourni par KOMPTO
# et saisir la clé prod dans l'UI (Facturation FNE → Enrôlement).

# --- FNE (legacy / fallback local) ------------------------------------------
# Anciennes variables DGI direct — conservées pour compatibilité. Préférer
# VITE_KOMPTO_* ci-dessus. Si aucune clé KOMPTO n'est configurée, ComptaCi
# génère les factures en BROUILLON local (numéro provisoire).
VITE_FNE_API_URL=https://fne.dgi.gouv.ci/api/v1
VITE_FNE_VERIF_URL=https://fne.dgi.gouv.ci/verification
