# --- Supabase (obligatoire) -------------------------------------------------
VITE_SUPABASE_URL=colle_ici_ton_project_url
VITE_SUPABASE_ANON_KEY=colle_ici_ta_cle_anon_public

# --- SasPay : paiement par lien (remplace l'ancien QR code Wave) -------------
# Les 3 liens ComptaCi sont déjà codés en dur dans `saspay.js` (aucune
# configuration requise). Ces variables permettent de les changer sans
# redéployer de code (utile en test).
VITE_SASPAY_URL_STARTER=https://link.saspay.me/vmtjcwrgafk
VITE_SASPAY_URL_PRO=https://link.saspay.me/vrgqoaut3ba
VITE_SASPAY_URL_ENTREPRISE=https://link.saspay.me/zszja0kudmy
# Lien générique de secours (toutes formules) — facultatif.
VITE_SASPAY_PAYMENT_URL=
VITE_SASPAY_MARCHAND=ComptaCi
# "test" pour tester sans encaisser, "live" en production
VITE_SASPAY_MODE=live

# --- Webhook SasPay (activation automatique des abonnements) ----------------
# Côté SUPABASE (jamais dans ce fichier, qui est exposé au navigateur) :
#   supabase secrets set SASPAY_WEBHOOK_SECRET=xxxxx   ← déjà configuré
#   supabase functions deploy webhook-saspay --no-verify-jwt
# Puis, dans le tableau de bord SasPay, renseigne l'URL :
#   https://<project-ref>.supabase.co/functions/v1/webhook-saspay
# Le webhook lit le secret tout seul (Deno.env.get) : rien à coller ici.

# --- Option FNE (facture normalisée) via KOMPTO -------------------------------
# L'option FNE est payante : 100 000 FCFA / an / établissement, disponible sur
# TOUS les forfaits (Starter, Fondateur, Pro, Entreprise). Les tarifs des
# forfaits ne changent pas.
#
# ⚠️ LA CLÉ API KOMPTO NE VA JAMAIS DANS CE FICHIER.
# Toute variable VITE_ est compilée dans le bundle JS public. La clé KOMPTO est
# une clé d'intégrateur partagée par tous les marchands : l'exposer permettrait
# d'émettre des factures certifiées frauduleuses au nom de ComptaCi.
# Elle se configure CÔTÉ SUPABASE, en secret serveur :
#   supabase secrets set KOMPTO_API_KEY=xxxxx
#   supabase secrets set KOMPTO_ENVIRONNEMENT=sandbox      # sandbox | production
#   supabase functions deploy fne-kompto                   # PAS --no-verify-jwt
#
# Le navigateur appelle la fonction Edge `fne-kompto`, qui relaie vers KOMPTO.
# ⚠️ Anciennes variables désactivées : `VITE_FNE_API_URL` et
# `VITE_FNE_VERIF_URL` pointaient vers une API DGI inventée
# (fne.dgi.gouv.ci/api/v1) qui n'existe pas. Elles ne sont plus utilisées.

# Environnement affiché dans le diagnostic côté client (sandbox par défaut).
# Ne permet PAS de basculer réellement : la bascule se fait côté serveur.
VITE_KOMPTO_ENVIRONNEMENT=sandbox

# --- Paiement de l'option FNE (lien SasPay dédié) -----------------------------
# ⚠️ Les 3 liens existants (starter/pro/entreprise) sont à montant FIXÉ côté
# SasPay : ils ne peuvent pas encaisser 100 000 FCFA. Il faut créer un 4e lien
# dédié à l'option FNE annuelle et coller son URL ci-dessous.
# Tant que cette variable est vide, l'activation se fait MANUELLEMENT
# (le commerçant paie, puis on active l'option depuis le back-office).
VITE_SASPAY_URL_FNE=
